# Phase 4 W8 — staging secrets. Template is .env.staging.example.
.env.staging

# Phase 4 W9 — Capacitor / Android.
# The android/ project IS committed: it carries the app icons, the manifest and
# the Gradle config, which are real source. Only build output and the copied
# web bundle are ignored — the bundle is regenerated by `npm run android:sync`
# and committing it would put a 2.8MB duplicate of the frontend in every diff.
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/capacitor-cordova-android-plugins/build/
frontend/out/

# Firebase config identifies the project and is per-environment.
# See docs/plan/phase4-android-release.md §4.
frontend/android/app/google-services.json
# Release signing material must never be committed. Losing the keystore
# means never updating the app under this package name again.
*.keystore
*.jks
frontend/android/keystore.properties

# Abandoned interpreter attempts from setup. Untracked, but ignore them
# so they never get added by a wildcard.
venv.python3.*

# Assistant tooling notes generated inside the frontend workspace. The
# root-level AGENTS.md and CLAUDE.md are the intentional ones.
frontend/AGENTS.md
frontend/CLAUDE.md
