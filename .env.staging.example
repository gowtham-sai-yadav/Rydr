# Staging environment template — Phase 4 W8.
#
#   cp .env.staging.example .env.staging   # then fill it in
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
#
# .env.staging is gitignored. Nothing here has a working default on purpose:
# the stack refuses to start with a variable missing rather than silently
# booting with a placeholder.

# --- database --------------------------------------------------------------
POSTGRES_USER=rydr
POSTGRES_PASSWORD=
POSTGRES_DB=rydr

# --- backend ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
# APP_ENV=staging makes config.py refuse to boot with the placeholder value.
SECRET_KEY=
APP_ENV=staging
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Comma-separated. Must include the frontend's public origin or every browser
# request fails CORS.
ALLOWED_ORIGINS=http://localhost:3000

# --- frontend --------------------------------------------------------------
# Baked in at build time. Must be reachable from the user's browser, so
# "http://backend:8000" (the compose service name) will not work.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --- integrations (all optional) -------------------------------------------
# Blank Cloudinary keys disable signed uploads; the URL-confirm path still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blank keeps OpenStreetMap. Setting it switches every map call to Mapbox.
MAPBOX_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Seed demo data on first boot. Leave false for anything with real data.
SEED_ON_START=false
