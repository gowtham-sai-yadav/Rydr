# Backend environment template.
# Copy to backend/.env for local dev. Backend .env is gitignored.

# Database connection string. Defaults match docker-compose.yml.
DATABASE_URL=postgresql://rydr:rydr_secret@localhost:5432/rydr

# JWT signing secret. For production, generate with:
#   openssl rand -hex 32
SECRET_KEY=replace-in-production-generate-with-openssl-rand-hex-32

# JWT algorithm. Leave as HS256 unless you know why you'd change it.
ALGORITHM=HS256

# Access token lifetime in minutes. 10080 = 7 days (dev default).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# M9 — environment flag. `dev` and `test` permit the placeholder SECRET_KEY
# above; `staging` and `prod` refuse to boot with it.
APP_ENV=dev

# M9 — comma-separated list of allowed CORS origins. M2 audit #14: the
# previously-hardcoded localhost:3000 broke any non-local deploy.
ALLOWED_ORIGINS=http://localhost:3000

# M4 — Cloudinary integration. Leave blank to disable signed uploads
# (the URL-confirm path still works). Get keys from
# https://console.cloudinary.com → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
