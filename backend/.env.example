# Backend environment template.
# Copy to backend/.env for local dev. Backend .env is gitignored.

# Database connection string. Defaults match docker-compose.yml.
DATABASE_URL=postgresql://rydr:rydr_secret@localhost:5432/rydr

# JWT signing secret. For production, generate with:
#   openssl rand -hex 32
SECRET_KEY=replace-in-production-generate-with-openssl-rand-hex-32

# JWT algorithm. Leave as HS256 unless you know why you'd change it.
ALGORITHM=HS256

# Access token lifetime in minutes. 10080 = 7 days (dev default).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
