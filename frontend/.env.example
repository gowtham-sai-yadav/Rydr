# Frontend environment template.
# Copy to frontend/.env.local for local dev. Frontend .env.local is gitignored.
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Powers the interactive destination map (mapbox-gl). Leave blank
# to fall back to a static list/grid of destinations with lat/lng shown —
# the app works fine without a token, just without the live map.
NEXT_PUBLIC_MAPBOX_TOKEN=
